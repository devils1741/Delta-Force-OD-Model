PROJECT_NAME           = "Delta TensorRT Screen Detector"
PROJECT_BRIEF          = "Windows DXGI + CUDA + TensorRT 实时屏幕目标检测 Demo"
OUTPUT_DIRECTORY       = "@DOXYGEN_OUTPUT_DIR@"
CREATE_SUBDIRS         = NO

INPUT                  = "@CMAKE_CURRENT_SOURCE_DIR@/src"
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.hpp *.cpp *.cu
EXCLUDE                =
EXCLUDE_PATTERNS       = */cmake-build-*/*

OUTPUT_LANGUAGE        = Chinese
QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = NO
JAVADOC_AUTOBRIEF      = YES

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = YES
SEARCHENGINE           = YES

GENERATE_LATEX         = NO
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
HAVE_DOT               = NO

CASE_SENSE_NAMES       = NO
OPTIMIZE_OUTPUT_FOR_C  = NO
EXTENSION_MAPPING      = cu=C++
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
